{
  "name": "noir-lounge",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.9.0" },
  "description": "Noir Lounge — restaurant, mixology and shisha lounge experience",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
